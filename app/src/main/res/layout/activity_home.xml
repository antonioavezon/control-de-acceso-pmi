<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".HomeActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/homeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/home_title"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/homeSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/home_subtitle"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/guestSummaryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/no_guest_list"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/formatHintText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/expected_csv_format"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/loadListButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="@string/load_guest_list" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/viewParticipantsButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:enabled="false"
            android:text="@string/view_participants" />

        <TextView
            android:id="@+id/emailSummaryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="@string/email_template_default"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/emailFormatHintText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/expected_email_format"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/loadEmailButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="@string/load_email_template" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="24dp"
            android:background="#33000000" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/invitationsButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/mode_invitations"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/accessButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="@string/mode_access"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/summaryButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="@string/mode_summary"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>
